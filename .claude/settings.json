      "Bash(wasm-bindgen:*)",
      "Bash(node:*)",
      "Bash(npm:*)",
      "Bash(tsc:*)",
      "Bash(python:*)",
      "Bash(python3:*)",
      "Bash(pip:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
