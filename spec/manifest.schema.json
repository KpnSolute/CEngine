{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.kpnsolute.com/cengine/v1/manifest.schema.json",
  "title": "CEngine template manifest (DRAFT v1)",
  "description": "A template is data. It declares entities, actions, states, invariants, projections and runtime needs. It carries no routes, secrets, tenant IDs, slugs or arbitrary code.",
  "type": "object",
  "required": ["manifest_version", "template", "entities"],
  "additionalProperties": false,
  "$defs": {
    "name": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,62}$" },
    "code": { "type": "integer", "minimum": 100, "maximum": 699 },
    "fieldType": {
      "enum": ["string", "text", "integer", "decimal", "boolean", "date", "datetime", "enum", "ref", "json", "file"]
    },
    "field": {
      "type": "object",
      "required": ["type"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/fieldType" },
        "required": { "type": "boolean", "default": false },
        "unique": { "type": "boolean", "default": false },
        "indexed": { "type": "boolean", "default": false },
        "searchable": { "type": "boolean", "default": false, "description": "Included in the `q` text search of list requests. string and text fields only." },
        "max_length": { "type": "integer", "minimum": 1 },
        "precision": { "type": "integer", "minimum": 1, "maximum": 38 },
        "scale": { "type": "integer", "minimum": 0, "maximum": 18 },
        "values": { "type": "array", "items": { "type": "string" }, "minItems": 1, "uniqueItems": true },
        "ref": { "$ref": "#/$defs/name", "description": "Target entity for type=ref." },
        "default": {},
        "computed": { "type": "string", "description": "Expression in the fixed CEngine expression language. Evaluated in the same transaction as the write." },
        "pii": { "type": "boolean", "default": false },
        "joins_lock": { "type": "boolean", "default": false, "description": "A write that sets this field is refused when the record would end up locked, as for a ref field (a plain field that picks the frozen window, such as a week number)." }
      },
      "allOf": [
        { "if": { "properties": { "type": { "const": "enum" } }, "required": ["type"] }, "then": { "required": ["values"] } },
        { "if": { "properties": { "type": { "const": "ref" } }, "required": ["type"] }, "then": { "required": ["ref"] } },
        { "if": { "properties": { "type": { "const": "decimal" } }, "required": ["type"] }, "then": { "required": ["precision", "scale"] } }
      ]
    },
    "stateModel": {
      "type": "object",
      "required": ["field", "states", "initial"],
      "additionalProperties": false,
      "properties": {
        "field": { "$ref": "#/$defs/name" },
        "initial": { "$ref": "#/$defs/name" },
        "states": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "$ref": "#/$defs/name" },
          "additionalProperties": {
            "type": "object",
            "required": ["code"],
            "additionalProperties": false,
            "properties": {
              "code": { "$ref": "#/$defs/code" },
              "to": { "type": "array", "items": { "$ref": "#/$defs/name" }, "uniqueItems": true }
            }
          }
        }
      }
    },
    "invariant": {
      "type": "object",
      "required": ["name", "expr"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "expr": { "type": "string" },
        "message_code": { "type": "string", "pattern": "^[a-z][a-z0-9_.]{0,62}$" }
      }
    },
    "entity": {
      "type": "object",
      "required": ["fields"],
      "additionalProperties": false,
      "properties": {
        "fields": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/field" } },
        "state": { "$ref": "#/$defs/stateModel" },
        "invariants": { "type": "array", "items": { "$ref": "#/$defs/invariant" } },
        "governed": { "type": "boolean", "default": false, "description": "Non-privileged writes become changeset operations that must be merged." },
        "emit_on_create": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$", "maxLength": 120, "description": "Event stored in the same transaction whenever a record of this entity is created, by anyone (staff, a guest, an import). Its data is {entity, id, actor, record}. Needs the `events` tool; subscriptions can react to it." },
        "soft_delete": { "type": "boolean", "default": true },
        "locked_when": { "type": "string", "description": "Expression. When true, writes fail with entity_locked." },
        "freeze_windows": { "type": "array", "items": { "type": "object", "required": ["field", "states"], "additionalProperties": false, "properties": { "field": { "$ref": "#/$defs/name" }, "states": { "type": "array", "items": { "$ref": "#/$defs/name" } } } } },
        "sort_keys": { "type": "array", "items": { "$ref": "#/$defs/name" }, "description": "Fields clients may sort by. Each must be indexed." }
      }
    },
    "action": {
      "type": "object",
      "required": ["entity", "effect"],
      "additionalProperties": false,
      "properties": {
        "entity": { "$ref": "#/$defs/name" },
        "input": { "type": "object", "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/field" } },
        "requires_state": { "type": "array", "items": { "$ref": "#/$defs/name" } },
        "effect": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "when": { "type": "string", "description": "Expression; the effect is skipped unless it is true." },
              "set": { "type": "object", "additionalProperties": { "type": "string" } },
              "update": { "type": "object", "required": ["entity", "id", "set"], "additionalProperties": false, "properties": { "entity": { "$ref": "#/$defs/name" }, "id": { "type": "string", "description": "Expression giving the record id, usually a ref field of the action's record." }, "set": { "type": "object", "additionalProperties": { "type": "string" } } } },
              "transition": { "$ref": "#/$defs/name" },
              "create": { "type": "object", "required": ["entity", "values"], "additionalProperties": false, "properties": { "entity": { "$ref": "#/$defs/name" }, "values": { "type": "object", "additionalProperties": { "type": "string" } } } },
              "carry": { "type": "object", "required": ["entity", "via", "values"], "additionalProperties": false, "properties": { "entity": { "$ref": "#/$defs/name" }, "via": { "$ref": "#/$defs/name", "description": "A ref field of `entity` that points at the action's entity. Every live record pointing at the action's record is copied." }, "values": { "type": "object", "additionalProperties": { "type": "string" }, "description": "Expressions over the source row's fields and `input.*`. Must set `via` to a different record." }, "requires": { "type": "string", "description": "Expression over the action's own record; the action is refused (409) unless it is true." } } },
              "emit": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$" }
            },
            "minProperties": 1
          }
        },
        "async": { "type": "boolean", "default": false, "description": "True returns 202 and a job." },
        "handler": { "type": "string", "description": "Optional reference to a sandboxed WASM handler by content hash. Escape hatch; reviewed per template." }
      }
    },
    "projection": {
      "type": "object",
      "required": ["entity", "fields"],
      "additionalProperties": false,
      "properties": {
        "entity": { "$ref": "#/$defs/name" },
        "fields": { "type": "array", "items": { "$ref": "#/$defs/name" }, "minItems": 1, "uniqueItems": true },
        "filter": { "type": "string" },
        "roles": { "type": "array", "items": { "$ref": "#/$defs/name" }, "minItems": 1, "uniqueItems": true, "description": "When set, the projection is not public: signed-in callers holding one of these roles read it at GET /v1/{inst}/_view/{projection}." }
      }
    },
    "guest_resource": {
      "type": "object",
      "required": ["entity", "owner_field", "body"],
      "additionalProperties": false,
      "description": "Rows a guest may create and list, only their own. The guest never names an entity, a field outside body.allow, an owner or a state.",
      "properties": {
        "entity": { "$ref": "#/$defs/name" },
        "owner_field": { "$ref": "#/$defs/name" },
        "fixed": { "type": "object", "description": "Fields the server sets on every row and filters every list by." },
        "stamp": { "type": "object", "additionalProperties": { "const": "today" }, "description": "Date fields set to today (UTC)." },
        "created_at_field": { "$ref": "#/$defs/name" },
        "title_field": { "$ref": "#/$defs/name" },
        "title": { "type": "string", "maxLength": 400 },
        "sort": { "type": "string", "maxLength": 80 },
        "body": {
          "type": "object",
          "required": ["as", "allow"],
          "additionalProperties": false,
          "properties": {
            "field": { "$ref": "#/$defs/name", "description": "JSON mode: the json field that holds what the guest sent." },
            "columns": { "type": "object", "minProperties": 1, "maxProperties": 40, "propertyNames": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$" }, "additionalProperties": { "$ref": "#/$defs/name" }, "description": "Column mode (instead of `field`): each form key and the entity field it is stored in. Keys in `allow` are what a guest may send; other keys here are server-owned (derived)." },
            "state_field": { "$ref": "#/$defs/name", "description": "Column mode: the entity's state field, shown to the guest as `status` and never writable by them." },
            "note_field": { "$ref": "#/$defs/name", "description": "Column mode: the field shown to the guest as `note`." },
            "status_map": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 40 }, "description": "State to the word the guest sees (for example approved to pending)." },
            "defaults": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 60 }, "description": "Form keys filled in from the guest's account when they send none: `$name`, `$email` or `profile.<question>`." },
            "as": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" },
            "allow": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$" }, "minItems": 1, "maxItems": 40, "uniqueItems": true },
            "required": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "rules": { "type": "array", "maxItems": 20, "items": { "type": "object", "required": ["expr", "message"], "additionalProperties": false, "properties": { "expr": { "type": "string", "maxLength": 400 }, "field": { "type": "string" }, "message": { "type": "string", "maxLength": 200 } } } },
            "derive": { "type": "object", "additionalProperties": { "type": "string", "maxLength": 400 } },
            "hide": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
            "state": { "type": "object", "required": ["key", "initial"], "additionalProperties": false, "properties": { "key": { "type": "string" }, "initial": { "type": "string" } } },
            "note_key": { "type": "string" },
            "max_bytes": { "type": "integer", "minimum": 64, "maximum": 65536 }
          }
        }
      }
    },
    "guest_feed": {
      "type": "object",
      "required": ["entity", "keys", "where", "fields"],
      "additionalProperties": false,
      "description": "Read-only list any signed-in guest may read: rows of one entity, filtered by an expression, showing only the declared fields. It never shows an owner, an id of the owner, or any key not declared.",
      "properties": {
        "entity": { "$ref": "#/$defs/name" },
        "fixed": { "type": "object", "description": "Fields every listed row must equal." },
        "body_field": { "$ref": "#/$defs/name", "description": "The json field the keys live in. Without it the keys are fields of the entity itself." },
        "enabled_by": { "type": "object", "required": ["entity", "match", "value_field", "key"], "additionalProperties": false, "description": "A switch managers control: the feed lists nothing while the setting's json has `key` set to false. A missing setting means on.", "properties": { "entity": { "$ref": "#/$defs/name" }, "match": { "type": "object", "required": ["field", "value"], "additionalProperties": false, "properties": { "field": { "$ref": "#/$defs/name" }, "value": { "type": "string" } } }, "value_field": { "$ref": "#/$defs/name" }, "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,39}$" } } },
        "keys": { "type": "array", "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,39}$" }, "minItems": 1, "maxItems": 40, "uniqueItems": true, "description": "The json keys expressions may read (snake_case in expressions); a missing key reads as null." },
        "where": { "type": "string", "maxLength": 400 },
        "fields": {
          "type": "object", "minProperties": 1, "maxProperties": 12,
          "propertyNames": { "pattern": "^[a-z][A-Za-z0-9_]{0,39}$" },
          "additionalProperties": {
            "type": "object", "additionalProperties": false, "minProperties": 1, "maxProperties": 1,
            "properties": { "from": { "type": "string" }, "expr": { "type": "string", "maxLength": 400 } }
          }
        },
        "sort": { "type": "string", "maxLength": 80, "description": "Order of the rows read from the store, newest first by default (for example -business_date)." },
        "order_by": { "type": "string", "maxLength": 80, "description": "Order of the result: a declared field, with a leading - for descending." },
        "scan": { "type": "integer", "minimum": 1, "maximum": 1000, "description": "Most rows read from the store before filtering (default 500)." },
        "limit": { "type": "integer", "minimum": 1, "maximum": 500, "description": "Most rows returned (default 200)." }
      }
    },
    "guest_public": {
      "type": "object",
      "required": ["entity", "match", "value_field"],
      "additionalProperties": false,
      "description": "One value anyone may read without signing in, from the row where match.field equals match.value.",
      "properties": {
        "entity": { "$ref": "#/$defs/name" },
        "match": { "type": "object", "required": ["field", "value"], "additionalProperties": false, "properties": { "field": { "$ref": "#/$defs/name" }, "value": { "type": "string" } } },
        "value_field": { "$ref": "#/$defs/name" }
      }
    },
    "report": {
      "type": "object",
      "required": ["entity", "measures"],
      "additionalProperties": false,
      "properties": {
        "entity": { "$ref": "#/$defs/name" },
        "title": { "type": "string", "maxLength": 120 },
        "group_by": { "type": "array", "items": { "$ref": "#/$defs/name" }, "maxItems": 4, "uniqueItems": true },
        "measures": {
          "type": "array", "minItems": 1, "maxItems": 12,
          "items": {
            "type": "object", "required": ["fn", "as"], "additionalProperties": false,
            "properties": {
              "fn": { "enum": ["count", "sum", "avg", "min", "max"] },
              "field": { "$ref": "#/$defs/name" },
              "as": { "$ref": "#/$defs/name" }
            }
          }
        },
        "filter": { "type": "string" },
        "params": { "type": "array", "items": { "$ref": "#/$defs/name" }, "maxItems": 6, "uniqueItems": true }
      }
    },
    "runtime": {
      "type": "object",
      "description": "Needs only. Never provider names, hosts or credentials.",
      "additionalProperties": false,
      "properties": {
        "storage": { "type": "object", "additionalProperties": false, "properties": { "relational": { "type": "boolean" }, "files": { "type": "boolean" }, "max_file_mb": { "type": "integer", "minimum": 1 } } },
        "compute": { "type": "object", "additionalProperties": false, "properties": { "jobs": { "type": "boolean" }, "schedules": { "type": "array", "items": { "type": "object", "required": ["name", "cron", "action"], "additionalProperties": false, "properties": { "name": { "$ref": "#/$defs/name" }, "cron": { "type": "string" }, "action": { "$ref": "#/$defs/name" } } } } } },
        "network": { "type": "object", "additionalProperties": false, "properties": { "public_projections": { "type": "boolean" }, "outbound_webhooks": { "type": "boolean" } } },
        "domains": { "type": "object", "additionalProperties": false, "properties": { "custom_domain": { "type": "boolean" } } }
      }
    }
  },
  "properties": {
    "manifest_version": { "const": 1 },
    "template": {
      "type": "object",
      "required": ["name", "version"],
      "additionalProperties": false,
      "properties": {
        "name": { "$ref": "#/$defs/name" },
        "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
        "title": { "type": "string" },
        "number": { "type": "integer", "minimum": 1, "description": "Assigned by the Template registry. Authors never set it; it is present in published manifests only." }
      }
    },
    "entities": { "type": "object", "minProperties": 1, "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/entity" } },
    "actions": { "type": "object", "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/action" } },
    "roles": { "type": "object", "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "type": "object", "additionalProperties": false, "properties": { "read": { "type": "array", "items": { "type": "string" } }, "write": { "type": "array", "items": { "type": "string" } }, "actions": { "type": "array", "items": { "type": "string" } } } } },
    "guest": {
      "type": "object",
      "required": ["role"],
      "additionalProperties": false,
      "description": "Guest accounts (email and password, outside the staff). Guest tokens carry only `role`, which must have no permissions; guests reach only what resources and public declare.",
      "properties": {
        "role": { "$ref": "#/$defs/name" },
        "profile": { "type": "array", "maxItems": 12, "description": "What onboarding asks a new guest, in order. Answers are stored on the account and can pre-fill a resource's form (`defaults`).", "items": { "type": "object", "required": ["key"], "additionalProperties": false, "properties": { "key": { "type": "string", "pattern": "^[a-z][a-z0-9_]{0,29}$" }, "label": { "type": "string", "minLength": 1, "maxLength": 60 }, "required": { "type": "boolean" }, "max_length": { "type": "integer", "minimum": 1, "maximum": 200 } } } },
        "resources": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,39}$" }, "additionalProperties": { "$ref": "#/$defs/guest_resource" } },
        "public": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,39}$" }, "additionalProperties": { "$ref": "#/$defs/guest_public" } },
        "feeds": { "type": "object", "propertyNames": { "pattern": "^[a-z][a-z0-9_]{0,39}$" }, "additionalProperties": { "$ref": "#/$defs/guest_feed" } }
      }
    },
    "projections": { "type": "object", "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/projection" } },
    "reports": { "type": "object", "propertyNames": { "$ref": "#/$defs/name" }, "additionalProperties": { "$ref": "#/$defs/report" } },
    "runtime": { "$ref": "#/$defs/runtime" },
    "subscriptions": {
      "type": "array",
      "maxItems": 32,
      "description": "Reactions to engine events. When the named event is stored, the engine creates the record in the same transaction. Needs the `events` tool. Values copy from the event or are literals; there is no code.",
      "items": {
        "type": "object",
        "required": ["event", "create"],
        "additionalProperties": false,
        "properties": {
          "event": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$", "maxLength": 120 },
          "create": {
            "type": "object",
            "required": ["entity", "values"],
            "additionalProperties": false,
            "properties": {
              "entity": { "$ref": "#/$defs/name" },
              "values": {
                "type": "object",
                "minProperties": 1,
                "propertyNames": { "$ref": "#/$defs/name" },
                "additionalProperties": {
                  "type": "object",
                  "additionalProperties": false,
                  "minProperties": 1,
                  "maxProperties": 1,
                  "properties": {
                    "from": { "type": "string", "description": "`name`, `subject`, `actor`, `at`, or `data.<field>[.<field>...]` of the event." },
                    "value": { "description": "A literal." }
                  }
                }
              }
            }
          }
        }
      }
    },
    "deliveries": {
      "type": "array",
      "maxItems": 32,
      "description": "Queued records the host delivers through a connector. The entity carries `status`, `attempts`, `not_before` and `last_error`; the relay sets them. Needs the `events` tool. The plugin holds no credential.",
      "items": {
        "type": "object",
        "required": ["entity", "connector", "operation"],
        "additionalProperties": false,
        "properties": {
          "entity": { "$ref": "#/$defs/name" },
          "connector": { "type": "string", "pattern": "^[a-z][a-z_]*$" },
          "operation": { "type": "string", "pattern": "^[a-z][a-z0-9_.]*$", "maxLength": 120 },
          "params": {
            "type": "object",
            "propertyNames": { "$ref": "#/$defs/name" },
            "additionalProperties": {
              "type": "object",
              "additionalProperties": false,
              "minProperties": 1,
              "maxProperties": 1,
              "properties": {
                "from": { "type": "string", "description": "`id` or a field of the entity." },
                "value": { "description": "A literal." }
              }
            }
          }
        }
      }
    },
    "provenance": {
      "type": "object",
      "description": "Written by composition, never by authors: which module and which digest-pinned plugin produced the rules. Recorded on every audit event.",
      "required": ["module"],
      "additionalProperties": false,
      "properties": {
        "module": { "type": "object", "required": ["name", "api"], "additionalProperties": false, "properties": { "name": { "type": "string" }, "api": { "type": "integer", "minimum": 1 } } },
        "plugin": { "type": "object", "required": ["id", "version", "digest"], "additionalProperties": false, "properties": { "id": { "type": "string" }, "version": { "type": "string" }, "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" } } }
      }
    }
  }
}
