{
  "tool": "customers",
  "version": "0.1.0",
  "title": "Customers and their contacts",
  "entities": {
    "customer": {
      "fields": {
        "name": {"type": "string", "required": true, "max_length": 160, "pii": true, "indexed": true},
        "kind": {"type": "enum", "values": ["person", "organization"], "default": "person", "indexed": true},
        "email": {"type": "string", "max_length": 254, "pii": true, "indexed": true},
        "phone": {"type": "string", "max_length": 40, "pii": true},
        "address": {"type": "text", "pii": true},
        "notes": {"type": "text"}
      },
      "sort_keys": ["name", "kind"]
    },
    "customer_contact": {
      "fields": {
        "customer": {"type": "ref", "ref": "customer", "required": true, "indexed": true},
        "name": {"type": "string", "required": true, "max_length": 160, "pii": true},
        "role": {"type": "string", "max_length": 120},
        "email": {"type": "string", "max_length": 254, "pii": true},
        "phone": {"type": "string", "max_length": 40, "pii": true}
      }
    }
  }
}
